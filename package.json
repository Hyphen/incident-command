{
	"name": "incident-command",
	"version": "0.1.0",
	"description": "Open source incident command: a skinnable status page, a management portal, and an MCP server so agents can run the whole thing. Deploy anywhere.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "Jared Wray <me@jaredwray.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/jaredwray/incident-command.git"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @incident-command/app dev",
		"build": "pnpm --filter @incident-command/app build",
		"start": "pnpm --filter @incident-command/app start",
		"lint": "biome check --write --error-on-warnings",
		"lint:ci": "biome check --error-on-warnings",
		"typecheck": "pnpm --filter @incident-command/app typecheck",
		"test": "pnpm --filter @incident-command/app test",
		"test:ci": "pnpm lint:ci && pnpm typecheck && pnpm test",
		"test:watch": "pnpm --filter @incident-command/app test:watch",
		"cf:dev": "pnpm --filter @incident-command/app cf:dev",
		"cf:deploy": "pnpm --filter @incident-command/app cf:deploy",
		"clean": "pnpm -r clean && rm -rf node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3"
	}
}
