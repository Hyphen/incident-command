# Keep the build context small and free of secrets.
# The build context is the repository root (a pnpm workspace).

# VCS / CI
.git
.github

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.next
**/.wrangler
.pnpm-store
**/coverage
**/*.tsbuildinfo
**/dist

# Local environment files and secrets
**/.env
**/.env.*
!.env.example
**/.dev.vars
**/.dev.vars.*

# Not needed to build the server.
packages/app/test
deploy
Dockerfile
.dockerignore
docker-compose.yml
npm-debug.log*
*.log
.DS_Store
